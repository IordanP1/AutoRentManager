@using AutoRentManager.ViewModels
@model IEnumerable<ReservationViewModel>

@{
    ViewData["Title"] = "Reservations";

    var reservations = Model.ToList();
    var totalReservations = reservations.Count;
    var pendingReservations = reservations.Count(r => r.Status == "Pending");
    var confirmedReservations = reservations.Count(r => r.Status == "Confirmed");
}


<div class="reservations-page">

    <div class="reservations-header">
        <div>
            <span class="reservations-eyebrow">ADMINISTRATION</span>
            <h1>Reservations</h1>
            <p>Manage customer bookings and reservation requests.</p>
        </div>

        <div class="reservations-total">
            <span>Total reservations</span>
            <strong>@totalReservations</strong>
        </div>
    </div>

    <div class="reservation-stats">

        <div class="reservation-stat">
            <div class="stat-icon stat-icon-total">R</div>
            <div>
                <span>Total Reservations</span>
                <strong>@totalReservations</strong>
            </div>
        </div>

        <div class="reservation-stat">
            <div class="stat-icon stat-icon-pending">!</div>
            <div>
                <span>Pending</span>
                <strong>@pendingReservations</strong>
            </div>
        </div>

        <div class="reservation-stat">
            <div class="stat-icon stat-icon-confirmed">✓</div>
            <div>
                <span>Confirmed</span>
                <strong>@confirmedReservations</strong>
            </div>
        </div>

    </div>

    <div class="reservations-table-card">

        <div class="reservations-table-header">
            <div>
                <h2>All Reservations</h2>
                <p>Review booking details and manage their status.</p>
            </div>

            <span class="reservation-count">
                @totalReservations bookings
            </span>
        </div>

        @if (!reservations.Any())
        {
            <div class="reservations-empty">
                <div class="empty-icon">R</div>
                <h3>No reservations yet</h3>
                <p>Customer bookings will appear here when they make a reservation.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="reservations-table">
                    <thead>
                        <tr>
                            <th>CAR</th>
                            <th>CUSTOMER</th>
                            <th>PICK-UP</th>
                            <th>RETURN</th>
                            <th>TOTAL PRICE</th>
                            <th>STATUS</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reservation in reservations)
                        {
                            <tr>
                                <td>
                                    <span class="reservation-car">
                                        @reservation.CarInfo
                                    </span>
                                </td>

                                <td>
                                    <span class="reservation-customer">
                                        @reservation.CustomerName
                                    </span>
                                </td>

                                <td>
                                    @reservation.StartDate.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @reservation.EndDate.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    <span class="reservation-price">
                                        @reservation.TotalPrice.ToString("F2")
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge status-@reservation.Status.ToLowerInvariant()">
                                        @reservation.Status
                                    </span>
                                </td>

                                <td>
                                    @if (User.IsInRole("Admin") && reservation.Status == "Pending")
                                    {
                                        <div class="reservation-actions">

                                            <form asp-controller="Reservations"
                                                  asp-action="Confirm"
                                                  asp-route-id="@reservation.Id"
                                                  method="post">
                                                <button type="submit"
                                                        class="reservation-btn confirm-btn">
                                                    Confirm
                                                </button>
                                            </form>

                                            <form asp-controller="Reservations"
                                                  asp-action="Cancel"
                                                  asp-route-id="@reservation.Id"
                                                  method="post">
                                                <button type="submit"
                                                        class="reservation-btn cancel-btn">
                                                    Cancel
                                                </button>
                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-actions">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>