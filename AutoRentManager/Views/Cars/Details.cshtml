@model AutoRentManager.Models.Car

@{
    ViewData["Title"] = "Car Details";
}

<h1>Car Details</h1>

<div class="card" style="max-width: 600px;">
    <img src="@Model.ImageUrl"
         class="card-img-top"
         alt="@Model.Brand @Model.Model"
         style="height: 300px; object-fit: cover;" />

    <div class="card-body">
        <h4 class="card-title">@Model.Brand @Model.Model</h4>

        <p><strong>Year:</strong> @Model.Year</p>
        <p><strong>Category:</strong> @Model.Category</p>
        <p><strong>Fuel:</strong> @Model.FuelType</p>
        <p><strong>Transmission:</strong> @Model.TransmissionType</p>
        <p><strong>Registration:</strong> @Model.RegistrationNumber</p>
        <p><strong>Price per day:</strong> @Model.PricePerDay.ToString("F2") Euro</p>
        <p><strong>Description:</strong> @Model.Description</p>

        <a asp-action="Index" class="btn btn-secondary">Back to Cars</a>
    </div>
</div>
