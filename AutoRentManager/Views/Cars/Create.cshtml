@model AutoRentManager.Models.Car

@{
    ViewData["Title"] = "Add New Car";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="mb-4">
                <a asp-action="Index"
                   class="text-decoration-none text-muted">
                    ← Back to Cars
                </a>

                <h1 class="fw-bold mt-3 mb-2">Add New Car</h1>
                <p class="text-muted">
                    Enter the vehicle details below to add it to your fleet.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Brand"
                                       class="form-label fw-semibold"></label>
                                <input asp-for="Brand"
                                       class="form-control"
                                       placeholder="e.g. BMW" />
                                <span asp-validation-for="Brand"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Model"
                                       class="form-label fw-semibold"></label>
                                <input asp-for="Model"
                                       class="form-control"
                                       placeholder="e.g. 330d" />
                                <span asp-validation-for="Model"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Year"
                                       class="form-label fw-semibold"></label>
                                <input asp-for="Year"
                                       class="form-control"
                                       type="number" />
                                <span asp-validation-for="Year"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PricePerDay"
                                       class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="PricePerDay"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />
                                    <span class="input-group-text">BGN / day</span>
                                </div>
                                <span asp-validation-for="PricePerDay"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Category"
                                       class="form-label fw-semibold"></label>
                                <select asp-for="Category"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<AutoRentManager.Enums.CarCategoryType.CarCategoryTypes>()">
                                    <option value="">Select category</option>
                                </select>
                                <span asp-validation-for="Category"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FuelType"
                                       class="form-label fw-semibold"></label>
                                <select asp-for="FuelType"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<AutoRentManager.Enums.FuelType.FuelTypes>()">
                                    <option value="">Select fuel type</option>
                                </select>
                                <span asp-validation-for="FuelType"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TransmissionType"
                                       class="form-label fw-semibold"></label>
                                <select asp-for="TransmissionType"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<AutoRentManager.Enums.TransmissionType.TransmissionTypes>()">
                                    <option value="">Select transmission</option>
                                </select>
                                <span asp-validation-for="TransmissionType"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="RegistrationNumber"
                                       class="form-label fw-semibold"></label>
                                <input asp-for="RegistrationNumber"
                                       class="form-control"
                                       placeholder="Enter registration number" />
                                <span asp-validation-for="RegistrationNumber"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description"
                                       class="form-label fw-semibold"></label>
                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Describe the vehicle..."></textarea>
                                <span asp-validation-for="Description"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ImageUrl" class="form-label fw-semibold">
                                    Car Image
                                </label>

                                <select asp-for="ImageUrl" class="form-select">
                                    <option value="">Select a car image</option>
                                    <option value="/images/cars/bmw340i.jpg">BMW 340i</option>
                                    <option value="/images/cars/bmw760l.jpg">BMW 760l</option>
                                    <option value="/images/cars/bmwM5Comp.jpg">BMW M5competition</option>
                                    <option value="/images/cars/bmwX5m.jpg">BMW X5m</option>
                                    <option value="/images/cars/bmwM4.jpg">BMW M4</option>

                                    <option value="/images/cars/van.jpg">Van</option>

                                </select>

                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Add Car
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```