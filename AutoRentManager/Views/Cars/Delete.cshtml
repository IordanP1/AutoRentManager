@using AutoRentManager.Models
@model Car
@{
    ViewData["Title"] = "Delete Car";
}
<h2>Delete Car</h2>
<p>Are you sure you want to delete this car?</p>
<div class="form-group">
    <label asp-for="Brand" class="control-label"></label>
    <input asp-for="Brand" class="form-control" readonly />
</div>
<div class="form-group">
    <label asp-for="Model" class="control-label"></label>
    <input asp-for="Model" class="form-control" readonly />
</div>
<div class="form-group">
    <label asp-for="Year" class="control-label"></label>
    <input asp-for="Year" class="form-control" readonly />
</div>
<div class="form-group">
    <label asp-for="PricePerDay" class="control-label"></label>
    <input asp-for="PricePerDay" class="form-control" readonly />
</div>
<form asp-action="DeleteConformation" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>