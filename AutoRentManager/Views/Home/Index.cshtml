@using AutoRentManager.Models
@model IEnumerable<Car>

@{
    ViewData["Title"] = "Available Cars";
}

<div class="container py-4">

    <section class="home-hero rounded-4 p-4 p-md-5 mb-5 text-white">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <p class="text-uppercase fw-semibold mb-2">
                    Your journey starts here
                </p>

                <h1 class="display-4 fw-bold mb-3">
                    Find the perfect car for your next adventure.
                </h1>

                <p class="lead mb-4">
                    Discover our cars, compare prices and reserve
                    the right vehicle for your journey.
                </p>

                <a href="#available-cars"
                   class="btn btn-light btn-lg fw-semibold">
                    Explore Cars
                </a>
            </div>
        </div>
    </section>

    <section id="available-cars">
        <div class="d-flex justify-content-between align-items-center
            flex-wrap gap-2 mb-4">
            <div>
                <h2 class="fw-bold mb-1">Available Cars</h2>
                <p class="text-muted mb-0">
                    Choose the car that suits you best.
                </p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-light border py-4 text-center">
                <h5>No cars available yet</h5>
                <p class="mb-0">
                    Please check back later for available vehicles.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var car in Model)
                {
                    <div class="col-sm-6 col-lg-4">
                        <div class="card car-card h-100 border-0 shadow-sm">

                            <img src="@car.ImageUrl"
                                 class="card-img-top car-image"
                                 alt="@car.Brand @car.Model" />

                            <div class="card-body d-flex flex-column p-4">
                                <p class="text-muted small mb-2">
                                    @car.Year · @car.Category
                                </p>

                                <h4 class="card-title fw-bold mb-3">
                                    @car.Brand @car.Model
                                </h4>

                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between
                                        align-items-center mb-3">
                                        <span class="text-muted">
                                            Price per day
                                        </span>

                                        <span class="fs-5 fw-bold">
                                            @car.PricePerDay.ToString("F2")
                                        </span>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <a asp-controller="Cars"
                                           asp-action="Details"
                                           asp-route-id="@car.Id"
                                           class="btn btn-outline-dark">
                                            View Details
                                        </a>

                                        <a asp-controller="Reservations"
                                           asp-action="Create"
                                           asp-route-carId="@car.Id"
                                           class="btn btn-primary">
                                            Reserve This Car
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>
